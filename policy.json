{
  "roles": {
    "guest": ["view"],
    "member": ["view", "post", "member"],
    "moderator": ["view", "post", "member", "moderate"],
    "admin": ["view", "post", "member", "moderate"]
  },
  "collections": {
    "user": {
      "read": "member",
      "write": "post",
      "scope": [
        { "filter": "oidc_sub = $jwt.custom.oidc_sub", "applies_to": "write", "unless_privilege": "moderate" }
      ]
    },
    "room": {
      "read": "view",
      "write": "post",
      "scope": [
        { "filter": "created_by = $jwt.sub", "applies_to": "write", "unless_privilege": "moderate" }
      ]
    },
    "message": {
      "read": "view",
      "write": "post",
      "scope": [
        { "filter": "user = $jwt.sub OR collaborative = true", "applies_to": "write", "unless_privilege": "moderate" }
      ]
    },
    "userroles": {
      "read": "member",
      "write": "system"
    },
    "ban": {
      "read": "view",
      "write": "moderate",
      "scope": [
        { "filter": "user = $jwt.sub", "applies_to": "read", "unless_privilege": "moderate" }
      ]
    },
    "reaction": {
      "read": "view",
      "write": "post",
      "scope": [
        { "filter": "user = $jwt.sub", "applies_to": "write" }
      ]
    },
    "readstate": {
      "read": "view",
      "write": "post",
      "scope": [
        { "filter": "user = $jwt.sub" }
      ]
    },
    "modaction": {
      "read": "member",
      "write": "moderate"
    },
    "notification": {
      "read": "view",
      "write": "post",
      "scope": [
        { "filter": "recipient = $jwt.sub" }
      ]
    },
    "linkpreview": {
      "read": "view",
      "write": "system"
    },
    "notificationpref": {
      "read": "view",
      "write": "post",
      "scope": [
        { "filter": "user = $jwt.sub" }
      ]
    },
    "dmthread": {
      "read": "view",
      "write": "post",
      "scope": [
        { "filter": "a = $jwt.sub OR b = $jwt.sub" }
      ]
    },
    "dmmessage": {
      "read": "view",
      "write": "post",
      "scope": [
        { "filter": "a = $jwt.sub OR b = $jwt.sub" },
        { "filter": "user = $jwt.sub", "applies_to": "write" }
      ]
    },
    "dmreadstate": {
      "read": "view",
      "write": "post",
      "scope": [
        { "filter": "user = $jwt.sub" }
      ]
    }
  }
}
